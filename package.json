{
    "name": "handlesport",
    "version": "1.0.0",
    "description": "HandleSport Scoring System",
    "author": "Mikhail Vorontsov",
    "main": "main.cjs",
    "type": "module",
    "scripts": {
        "start": "electron .",
        "dist": "electron-builder",
        "dist:mac": "electron-builder --mac"
    },
    "dependencies": {
        "cors": "^2.8.6",
        "express": "^5.2.1",
        "firebase": "^12.14.0",
        "jsonwebtoken": "^9.0.3",
        "uuid": "^14.0.0"
    },
    "build": {
        "appId": "com.handlesport.app",
        "productName": "HandleSport",
        "directories": {
            "output": "dist"
        },
        "win": {
            "target": "nsis"
        },
        "mac": {
            "target": "dmg",
            "category": "public.app-category.sports"
        }
    },
    "devDependencies": {
        "electron": "^43.0.0",
        "electron-builder": "^26.15.0"
    }
}
